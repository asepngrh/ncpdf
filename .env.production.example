# Production Environment Variables for ncpdf

# Server Utama (Primary Gotenberg container - misal: Railway / VPS / Render)
GOTENBERG_URL=https://your-gotenberg-instance.railway.app

# Server Cadangan (Fallback Gotenberg container - opsional)
# Jika server utama timeout/down, sistem otomatis beralih ke server cadangan
GOTENBERG_FALLBACK_URL=https://your-backup-gotenberg.koyeb.app
